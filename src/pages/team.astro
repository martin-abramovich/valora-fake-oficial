---
import { getCollection } from 'astro:content';
import SolutionLayout from '../layouts/SolutionLayout.astro';
import { netlifyImage } from '../lib/netlifyImage';
import { US_REGIONS, CANADA_REGION } from '../lib/usRegions';
import teamData from '../content/settings/team.json';

if (!teamData.published) {
  return Astro.redirect('/');
}

const allMembers = await getCollection('team');
const members = allMembers.sort((a, b) => a.data.order - b.data.order);

// Initials shown in the photo slot until a real headshot is uploaded via the CMS.
function initials(name: string): string {
  return name
    .split(' ')
    .map((part) => part[0])
    .filter(Boolean)
    .slice(0, 2)
    .join('')
    .toUpperCase();
}

const allReps = await getCollection('reps');

// One rep can cover several region codes (e.g. Alaska + Arkansas + Colorado),
// and a region can have more than one rep (e.g. VA has both Wendy and Martha
// Vlahakis), so we invert everyone's `regions` lists into a code → reps[] lookup.
const repsByCode = new Map<string, (typeof allReps)[number]['data'][]>();
for (const rep of allReps) {
  for (const code of rep.data.regions) {
    const existing = repsByCode.get(code);
    if (existing) existing.push(rep.data);
    else repsByCode.set(code, [rep.data]);
  }
}

// Only regions an actual rep covers show up in the dropdown — driven entirely by
// the `reps` collection, so assigning a new region to a rep in the CMS is enough
// to add it here; nothing is hardcoded.
const regions = US_REGIONS.map((region) => ({
  ...region,
  reps: repsByCode.get(region.code) ?? [],
})).filter((region) => region.reps.length > 0);

const canadaReps = repsByCode.get(CANADA_REGION.code) ?? [];

// Resolve photos through Netlify's image CDN once, server-side, since the result
// panel is built client-side from this JSON and has no access to `netlifyImage`.
function toRepPayload(rep: (typeof allReps)[number]['data']) {
  return {
    name: rep.name,
    company: rep.company,
    email: rep.email,
    phone: rep.phone,
    photo: rep.photo ? netlifyImage(rep.photo, { width: 300 }) : null,
  };
}

// Fed to the client script so the dropdown can update the result panel without a page reload.
const regionData = Object.fromEntries(
  [...regions, ...(canadaReps.length > 0 ? [{ ...CANADA_REGION, reps: canadaReps }] : [])].map((r) => [
    r.code,
    { label: r.label, reps: r.reps.map(toRepPayload) },
  ])
);
---

<SolutionLayout title="Team — Valora" description="A collective of visionaries — forty years of technical expertise and a discerning creative perspective.">

  <!-- Title band -->
  <section class="bg-dark pt-40 pb-20 md:pt-48 md:pb-24 px-6 md:px-16">
    <div class="max-w-4xl mx-auto">
      <p class="reveal font-body text-xs tracking-widest2 text-teal uppercase mb-6">
        Valora
      </p>
      <h1 class="reveal font-heading text-cream text-5xl md:text-7xl font-light leading-[1.05] mb-6 delay-100">
        {teamData.page_heading}
      </h1>
      <p class="reveal font-body text-cream/80 text-sm md:text-base leading-relaxed max-w-2xl delay-200">
        {teamData.page_description}
      </p>
    </div>
  </section>

  <!-- Team grid -->
  <section class="bg-cream py-16 md:py-20 px-6 md:px-16">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-14">
        {members.map((member, i) => (
          <article class={`reveal delay-${(i % 3) * 100 + 100}`}>

            <!-- Photo slot: real headshot if uploaded, otherwise an initials placeholder -->
            <div class="relative overflow-hidden aspect-4/5 bg-dark/5 mb-5 max-w-60">
              {member.data.photo ? (
                <img
                  src={netlifyImage(member.data.photo, { width: 480 })}
                  alt={member.data.name}
                  class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <span class="font-script text-teal/50 text-6xl">{initials(member.data.name)}</span>
                </div>
              )}
              <div class="absolute bottom-0 left-0 w-1 h-16 bg-gold" />
            </div>

            <h2 class="font-heading text-dark text-xl md:text-2xl font-light leading-tight mb-1.5">
              {member.data.name}
            </h2>
            <p class="font-body text-xs tracking-widest2 text-teal uppercase">
              {member.data.role}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Rep locator -->
  <section id="reps" class="bg-dark py-20 md:py-28 px-6 md:px-16">
    <div class="max-w-xl mx-auto text-center">
      <p class="reveal font-body text-xs tracking-widest2 text-teal uppercase mb-4">
        Find Your Rep
      </p>
      <h2 class="reveal font-heading text-cream text-3xl md:text-4xl font-light leading-[1.2] mb-4 delay-100">
        Every region has a dedicated representative.
      </h2>
      <p class="reveal font-body text-cream/60 text-sm md:text-base leading-relaxed mb-12 delay-200">
        Choose your region below to see who to reach out to directly.
      </p>

      <!--
        Custom combobox instead of a native <select>: the only way to find a rep, so it's
        built to feel like the page's main event, not a form afterthought — and a native
        select's option list is positioned by the browser (it can flip and open upward),
        which fought the deliberate layout here. This version always opens directly below
        the trigger and scrolls internally instead.
      -->
      <div class="reveal delay-300 relative max-w-sm mx-auto" id="region-picker">
        <p class="font-body text-[11px] tracking-widest2 uppercase text-cream/40 mb-2" id="region-picker-label">
          Select your region
        </p>
        <button
          type="button"
          id="region-trigger"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-labelledby="region-picker-label region-trigger"
          class="w-full flex items-center justify-center gap-2 bg-transparent border-b border-cream/25 pb-3
                 font-heading text-2xl md:text-3xl font-light text-cream
                 focus:outline-none focus:border-gold transition-colors duration-300"
        >
          <span id="region-trigger-value" class="text-cream/50">Choose…</span>
          <span aria-hidden="true" id="region-trigger-caret" class="text-gold text-xs shrink-0 transition-transform duration-300">▾</span>
        </button>

        <ul
          id="region-listbox"
          role="listbox"
          aria-labelledby="region-picker-label"
          tabindex="-1"
          class="hidden absolute inset-x-0 top-full z-30 mt-3 max-h-64 overflow-y-auto
                 border border-cream/15 bg-dark shadow-xl shadow-black/40 py-2 text-left"
        >
          {regions.map((r) => (
            <li role="option" id={`region-option-${r.code}`} data-code={r.code}
                class="px-4 py-2 font-body text-sm text-cream/75 cursor-pointer transition-colors duration-150 hover:bg-cream/10 hover:text-cream">
              {r.label}
            </li>
          ))}
          {canadaReps.length > 0 && (
            <li role="option" id={`region-option-${CANADA_REGION.code}`} data-code={CANADA_REGION.code}
                class="px-4 py-2 font-body text-sm text-cream/75 cursor-pointer transition-colors duration-150 hover:bg-cream/10 hover:text-cream border-t border-cream/10 mt-1 pt-3">
              {CANADA_REGION.label}
            </li>
          )}
        </ul>
      </div>

      <!-- Result -->
      <div id="rep-panel" class="reveal delay-400 mt-14">
        <p id="rep-panel-empty" class="font-body text-cream/35 text-sm leading-relaxed">
          Your rep's contact details will appear here once you choose a region.
        </p>

        <div id="rep-panel-content" class="hidden">
          <p class="font-body text-xs tracking-widest2 text-teal uppercase mb-8" id="rep-panel-region"></p>
          <!-- Populated client-side: one block per rep, since a region can have more than one (e.g. Virginia). -->
          <div id="rep-panel-contacts" class="space-y-10"></div>
        </div>
      </div>

      <script type="application/json" id="region-data" set:html={JSON.stringify(regionData)} />
    </div>
  </section>

  <!-- Closing banner -->
  <section class="bg-white py-16 md:py-20 px-6 md:px-16">
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center gap-8">
      <div class="reveal flex flex-col sm:flex-row gap-4">
        <a href="/#contact" class="btn-filled-teal sm:whitespace-nowrap">
          Bring your vision to life
        </a>
        <a href="/#solutions" class="btn-filled-teal sm:whitespace-nowrap">
          Discover our bespoke solutions
        </a>
      </div>
    </div>
  </section>

</SolutionLayout>

<script>
  interface RepData {
    name: string;
    company: string;
    email: string;
    phone: string;
    photo: string | null;
  }
  interface RegionEntry {
    label: string;
    reps: RepData[];
  }

  const dataEl = document.getElementById('region-data');
  const regionData: Record<string, RegionEntry> = dataEl ? JSON.parse(dataEl.textContent ?? '{}') : {};

  const picker   = document.getElementById('region-picker');
  const trigger  = document.getElementById('region-trigger') as HTMLButtonElement | null;
  const triggerValue = document.getElementById('region-trigger-value');
  const triggerCaret = document.getElementById('region-trigger-caret');
  const listbox  = document.getElementById('region-listbox');
  const options  = listbox ? Array.from(listbox.querySelectorAll<HTMLLIElement>('[role="option"]')) : [];

  const panelEmpty   = document.getElementById('rep-panel-empty');
  const panelContent = document.getElementById('rep-panel-content');

  const elRegion   = document.getElementById('rep-panel-region');
  const elContacts = document.getElementById('rep-panel-contacts');

  // Mirrors the initials placeholder used for team members without a headshot,
  // so the rep card reads as part of the same visual family as the grid above.
  function initials(name: string): string {
    return name
      .split(' ')
      .map((part) => part[0])
      .filter(Boolean)
      .slice(0, 2)
      .join('')
      .toUpperCase();
  }

  function dtDd(label: string, valueEl: HTMLElement): HTMLDivElement {
    const row = document.createElement('div');
    const dt = document.createElement('dt');
    dt.className = 'text-cream/40 text-[11px] tracking-widest2 uppercase mb-0.5';
    dt.textContent = label;
    const dd = document.createElement('dd');
    dd.appendChild(valueEl);
    row.append(dt, dd);
    return row;
  }

  function renderContact(rep: RepData): HTMLDivElement {
    const wrap = document.createElement('div');
    wrap.className = 'text-center';

    let portrait: HTMLElement;
    if (rep.photo) {
      const img = document.createElement('img');
      img.className = 'w-36 h-36 rounded-full object-cover mx-auto mb-3 ring-2 ring-gold/40';
      img.src = rep.photo;
      img.alt = rep.name;
      img.loading = 'lazy';
      portrait = img;
    } else {
      const initial = document.createElement('span');
      initial.className = 'font-script text-gold/70 text-6xl block mb-3';
      initial.textContent = initials(rep.name);
      portrait = initial;
    }

    const name = document.createElement('h3');
    name.className = 'font-heading text-cream text-2xl font-light leading-tight';
    name.textContent = rep.name;

    const divider = document.createElement('span');
    divider.className = 'w-16 h-px bg-gold/70 mx-auto my-4 block';

    const company = document.createElement('span');
    company.className = 'text-cream';
    company.textContent = rep.company;

    const email = document.createElement('a');
    email.className = 'text-teal hover:underline';
    email.textContent = rep.email;
    email.href = `mailto:${rep.email}`;

    const phone = document.createElement('a');
    phone.className = 'text-teal hover:underline';
    phone.textContent = rep.phone;
    phone.href = `tel:${rep.phone.replace(/[^\d+]/g, '')}`;

    const dl = document.createElement('dl');
    dl.className = 'space-y-3 font-body text-sm';
    dl.append(dtDd('Company', company), dtDd('Email', email), dtDd('Phone', phone));

    wrap.append(portrait, name, divider, dl);
    return wrap;
  }

  function selectRegion(code: string) {
    const entry = regionData[code];
    if (!entry) return;

    panelEmpty?.classList.add('hidden');
    panelContent?.classList.remove('hidden');

    if (elRegion) elRegion.textContent = entry.label;
    if (elContacts) {
      elContacts.replaceChildren(...entry.reps.map(renderContact));
    }
  }

  // Custom listbox interaction (ARIA "collapsible dropdown listbox" pattern) — the
  // trigger only opens/closes; once open, DOM focus moves onto the listbox itself so
  // arrow keys, Home/End, and typeahead all work without re-wiring the trigger.
  let activeIndex = -1;
  let typeahead = '';
  let typeaheadTimer: ReturnType<typeof setTimeout> | undefined;

  function setActiveIndex(index: number) {
    if (options.length === 0 || !listbox) return;
    activeIndex = (index + options.length) % options.length;
    const active = options[activeIndex];
    options.forEach((o) => o.classList.remove('bg-cream/10', 'text-cream'));
    active.classList.add('bg-cream/10', 'text-cream');
    listbox.setAttribute('aria-activedescendant', active.id);
    active.scrollIntoView({ block: 'nearest' });
  }

  function openListbox() {
    if (!listbox || !trigger) return;
    listbox.classList.remove('hidden');
    trigger.setAttribute('aria-expanded', 'true');
    triggerCaret?.classList.add('rotate-180');
    const selected = options.findIndex((o) => o.getAttribute('aria-selected') === 'true');
    setActiveIndex(selected >= 0 ? selected : 0);
    listbox.focus();
  }

  function closeListbox(focusTrigger = false) {
    if (!listbox || !trigger) return;
    listbox.classList.add('hidden');
    trigger.setAttribute('aria-expanded', 'false');
    triggerCaret?.classList.remove('rotate-180');
    listbox.removeAttribute('aria-activedescendant');
    activeIndex = -1;
    if (focusTrigger) trigger.focus();
  }

  function isOpen() {
    return !listbox?.classList.contains('hidden');
  }

  function choose(option: HTMLLIElement | undefined) {
    if (!option) return;
    const code = option.dataset.code;
    if (!code) return;

    options.forEach((o) => o.removeAttribute('aria-selected'));
    option.setAttribute('aria-selected', 'true');

    if (triggerValue) {
      triggerValue.textContent = option.textContent?.trim() ?? '';
      triggerValue.classList.remove('text-cream/50');
    }

    closeListbox(true);
    selectRegion(code);
  }

  trigger?.addEventListener('click', () => {
    if (isOpen()) closeListbox();
    else openListbox();
  });

  trigger?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      openListbox();
    }
  });

  listbox?.addEventListener('keydown', (e) => {
    switch (e.key) {
      case 'ArrowDown':
        e.preventDefault();
        setActiveIndex(activeIndex + 1);
        break;
      case 'ArrowUp':
        e.preventDefault();
        setActiveIndex(activeIndex - 1);
        break;
      case 'Home':
        e.preventDefault();
        setActiveIndex(0);
        break;
      case 'End':
        e.preventDefault();
        setActiveIndex(options.length - 1);
        break;
      case 'Enter':
      case ' ':
        e.preventDefault();
        choose(options[activeIndex]);
        break;
      case 'Escape':
        e.preventDefault();
        closeListbox(true);
        break;
      case 'Tab':
        closeListbox();
        break;
      default:
        if (e.key.length === 1 && /[a-z0-9]/i.test(e.key)) {
          typeahead += e.key.toLowerCase();
          clearTimeout(typeaheadTimer);
          typeaheadTimer = setTimeout(() => { typeahead = ''; }, 600);
          const match = options.findIndex((o) => o.textContent?.trim().toLowerCase().startsWith(typeahead));
          if (match >= 0) setActiveIndex(match);
        }
    }
  });

  options.forEach((option, i) => {
    option.addEventListener('click', () => choose(option));
    option.addEventListener('mousemove', () => setActiveIndex(i));
  });

  document.addEventListener('click', (e) => {
    if (picker && !picker.contains(e.target as Node)) closeListbox();
  });

  // Deep link support: /team#reps, lands on the section so visitors can pick from the dropdown.
  if (window.location.hash === '#reps') {
    document.getElementById('reps')?.scrollIntoView();
  }
</script>
