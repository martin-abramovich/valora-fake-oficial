---
import SolutionLayout from '../layouts/SolutionLayout.astro';
import aboutData from '../content/settings/about.json';
import { netlifyImage } from '../lib/netlifyImage';

const darkBodyParagraphs = aboutData.dark_body.split('\n\n');
const pageBodyParagraphs = aboutData.page_body.split('\n\n');
---

<SolutionLayout title="About — Valora" description={aboutData.eyebrow} navbarSolid={true} footerSolid={true}>

  <!-- Title: same title & text as the home About preview, in color, no solid background -->
  <section class="bg-cream pt-36 pb-16 md:pt-44 md:pb-20 px-6 md:px-16">
    <div class="max-w-7xl mx-auto">
      <p class="reveal font-body text-xs tracking-widest2 text-teal uppercase mb-6">
        {aboutData.eyebrow}
      </p>
      <h1 class="reveal font-heading text-teal text-5xl md:text-7xl font-light leading-[1.05] mb-8 delay-100 max-w-4xl">
        {aboutData.heading_before_em}<em class="font-script not-italic font-normal">{aboutData.heading_em}</em>{aboutData.heading_after_em}
      </h1>
      <div class="reveal space-y-5 max-w-2xl delay-200">
        {aboutData.paragraphs.map((para: string) => (
          <p class="font-body text-dark/70 text-sm md:text-base leading-relaxed">
            {para}
          </p>
        ))}
      </div>
    </div>
  </section>

  <!-- Chapter 01 — sticky text panel over a scrolling background photo -->
  <section class="relative min-h-[170vh] md:min-h-[160vh]">
    <div class="absolute inset-0">
      <img
        src={netlifyImage(aboutData.dark_image, { width: 1920 })}
        alt={aboutData.dark_image_alt}
        class="w-full h-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-dark/60" />
    </div>

    <div class="sticky top-0 h-screen flex flex-col justify-between px-6 md:px-16 pt-28 pb-16 md:pt-32 md:pb-20">
      <!-- Corner micro-labels -->
      <div class="reveal flex items-start justify-between max-w-7xl mx-auto w-full">
        <span class="font-body text-[11px] tracking-widest2 text-cream/70 uppercase">About Valora</span>
        <span class="font-body text-[11px] tracking-widest2 text-cream/70 uppercase text-right">01 — Philosophy</span>
      </div>

      <!-- Panel -->
      <div class="max-w-7xl mx-auto w-full">
        <h2 class="reveal font-heading text-cream text-3xl md:text-4xl font-light leading-[1.2] mb-6 delay-100">
          {aboutData.dark_subtitle}
        </h2>
        <div class="reveal space-y-5 max-w-2xl delay-200">
          {darkBodyParagraphs.map((para: string) => (
            <p class="font-body text-cream/85 text-sm md:text-base leading-relaxed">
              {para}
            </p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter 02 — sticky text panel over a scrolling background photo -->
  <section class="relative min-h-[170vh] md:min-h-[160vh]">
    <div class="absolute inset-0">
      <img
        src={netlifyImage(aboutData.page_image, { width: 1920 })}
        alt={aboutData.page_image_alt}
        class="w-full h-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-dark/60" />
    </div>

    <div class="sticky top-0 h-screen flex flex-col justify-between px-6 md:px-16 pt-28 pb-16 md:pt-32 md:pb-20">
      <!-- Corner micro-labels -->
      <div class="reveal flex items-start justify-between max-w-7xl mx-auto w-full">
        <span class="font-body text-[11px] tracking-widest2 text-cream/70 uppercase">About Valora</span>
        <span class="font-body text-[11px] tracking-widest2 text-cream/70 uppercase text-right">02 — Craft &amp; Detail</span>
      </div>

      <!-- Panel -->
      <div class="max-w-7xl mx-auto w-full">
        <h2 class="reveal font-heading text-cream text-3xl md:text-4xl font-light leading-[1.2] mb-6 delay-100">
          {aboutData.page_subtitle}
        </h2>
        <div class="reveal space-y-5 max-w-2xl delay-200">
          {pageBodyParagraphs.map((para: string) => (
            <p class="font-body text-cream/85 text-sm md:text-base leading-relaxed">
              {para}
            </p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Closing banner -->
  <section class="bg-white py-16 md:py-20 px-6 md:px-16">
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center gap-8">
      <div class="reveal flex flex-col sm:flex-row gap-4">
        <a href="/contact" class="btn-filled-teal sm:whitespace-nowrap">
          Bring your vision to life
        </a>
        <a href="/#solutions" class="btn-filled-teal sm:whitespace-nowrap">
          Discover our bespoke solutions
        </a>
      </div>
    </div>
  </section>

</SolutionLayout>
