---
import { getCollection, type CollectionEntry } from 'astro:content';
import SolutionLayout from '../../layouts/SolutionLayout.astro';
import { netlifyImage } from '../../lib/netlifyImage';
import { solutionSlug } from '../../lib/solutionSlug';

export async function getStaticPaths() {
  const solutions = await getCollection('solutions');
  return solutions.map((entry) => ({
    params: { slug: solutionSlug(entry.id) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'solutions'>;
}

const { entry } = Astro.props;
const { title, description, images, category_descriptions, documents } = entry.data;

// Unique subcategory tags (in first-seen order), used to build the gallery filter.
// Untagged images are always visible and unaffected by these filters.
const tags = [...new Set(images.map((img) => img.tag).filter((t): t is string => Boolean(t)))];

// Optional per-tag blurb, shown under the filters once a visitor picks one.
const tagDescriptions = Object.fromEntries(
  (category_descriptions ?? []).map((c) => [c.tag, c.description])
);

// Title-band background slider: the solution's own first 3 photos, in the
// order set on the entry — simplest option that needs no extra CMS field.
const heroSlides = images.slice(0, 3).map((img) => netlifyImage(img.src, { width: 1920 }));
const heroTrackSlides = heroSlides.length > 1 ? [...heroSlides, heroSlides[0]] : heroSlides;
---

<SolutionLayout title={`${title} — Valora`} description={description}>

  <!-- Title band -->
  <section class="relative overflow-hidden bg-dark pt-40 pb-20 md:pt-48 md:pb-24 px-6 md:px-16">
    {heroSlides.length > 0 && (
      <div class="hero-slider absolute inset-0" aria-hidden="true">
        <div
          class="hero-slider-track flex h-full will-change-transform"
          style={`width: ${heroTrackSlides.length * 100}%; transition: transform 1200ms cubic-bezier(0.65, 0, 0.35, 1);`}
        >
          {heroTrackSlides.map((src, i) => (
            <div class="h-full flex-none overflow-hidden" style={`width: ${100 / heroTrackSlides.length}%`}>
              <div
                class={`hero-slide-img w-full h-full bg-cover bg-center bg-no-repeat ${i === 0 ? 'is-zooming' : ''}`}
                style={`background-image: url('${src}');`}
              />
            </div>
          ))}
        </div>

        <!-- Dark gradient overlay, fixed above every slide, for text legibility -->
        <div class="absolute inset-0 bg-linear-to-r from-dark/95 via-dark/50 to-dark/20" />
      </div>
    )}

    <div class="relative z-10 max-w-4xl mx-auto">
      <p class="reveal font-body text-xs tracking-widest2 text-teal uppercase mb-6">
        Bespoke Solutions
      </p>
      <h1 class="reveal font-heading text-cream text-5xl md:text-7xl font-light leading-[1.05] mb-6 delay-100">
        {title}
      </h1>
      <p class="reveal font-body text-cream/80 text-sm md:text-base leading-relaxed max-w-2xl delay-200">
        {description}
      </p>
    </div>
  </section>

  <!-- Gallery -->
  <section class="bg-cream py-16 md:py-20 px-6 md:px-16">
    <div class="max-w-7xl mx-auto">

      {tags.length > 0 && (
        <>
          <div class="reveal flex flex-wrap gap-3 mb-6">
            {tags.map((tag) => (
              <button
                type="button"
                data-filter={tag}
                data-description={tagDescriptions[tag] ?? ''}
                class="gallery-filter font-body text-xs tracking-widest2 uppercase px-5 py-2.5 border border-dark/25 text-dark transition-colors duration-300"
              >
                {tag}
              </button>
            ))}
          </div>

          <p class="gallery-filter-description font-body text-dark/70 text-sm md:text-base leading-relaxed max-w-2xl mb-10 opacity-0 transition-opacity duration-300"></p>
        </>
      )}

      <!-- Gallery grid: a curated set of photos, shown large and editorial, click to open the lightbox -->
      <div class="gallery-grid grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
        {images.map((img, i) => (
          <button
            type="button"
            class={`gallery-tile reveal aspect-4/5 overflow-hidden group delay-${(i % 2) * 150 + 100}`}
            data-index={i}
            data-tag={img.tag ?? ''}
            aria-label={`View ${img.alt}`}
          >
            <img
              src={netlifyImage(img.src, { width: 1000 })}
              alt={img.alt}
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
              loading="lazy"
            />
          </button>
        ))}
      </div>

      <script type="application/json" id="gallery-data" is:inline set:html={JSON.stringify(
        images.map((img) => ({ src: netlifyImage(img.src, { width: 1600 }), alt: img.alt }))
      )} />

      <!-- Lightbox -->
      <div class="lightbox fixed inset-0 z-50 hidden items-center justify-center bg-dark/95 p-4 md:p-10" role="dialog" aria-modal="true">
        <button type="button" class="lightbox-close absolute top-5 right-5 md:top-8 md:right-8 w-10 h-10 flex items-center justify-center text-cream/80 hover:text-cream text-3xl leading-none transition-colors duration-200" aria-label="Close">
          &times;
        </button>

        <button type="button" class="lightbox-prev absolute left-3 md:left-8 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center text-cream/80 hover:text-cream text-3xl leading-none transition-colors duration-200" aria-label="Previous image">
          ‹
        </button>

        <img class="lightbox-img max-w-full max-h-[80vh] object-contain" src="" alt="" />

        <button type="button" class="lightbox-next absolute right-3 md:right-8 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center text-cream/80 hover:text-cream text-3xl leading-none transition-colors duration-200" aria-label="Next image">
          ›
        </button>

        <p class="lightbox-counter absolute bottom-5 md:bottom-8 left-1/2 -translate-x-1/2 font-body text-xs tracking-widest2 text-cream/70 uppercase"></p>
      </div>

      {documents && documents.length > 0 && (
        <div class="reveal mt-16 pt-16 border-t border-dark/10">
          <p class="font-body text-xs tracking-widest2 text-teal uppercase mb-6">
            Technical Documents
          </p>
          <div class="flex flex-wrap gap-4">
            {documents.map((doc) => (
              <a
                href={doc.file}
                download={doc.file !== '#' || undefined}
                target={doc.file !== '#' ? '_blank' : undefined}
                class="font-body text-xs tracking-widest2 uppercase text-dark border border-dark/25 px-6 py-3.5 flex items-center gap-3 hover:border-teal hover:text-teal transition-colors duration-300"
              >
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="flex-none">
                  <path d="M8 1V11M8 11L4 7M8 11L12 7M2 14H14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {doc.label}
              </a>
            ))}
          </div>
        </div>
      )}

    </div>
  </section>

  <!-- Closing banner -->
  <section class="bg-white py-16 md:py-20 px-6 md:px-16">
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center gap-8">
      <div class="reveal flex flex-col sm:flex-row gap-4">
        <a href="/#contact" class="btn-filled-teal sm:whitespace-nowrap">
          Bring your vision to life
        </a>
        <a href="/#solutions" class="btn-filled-teal sm:whitespace-nowrap">
          Discover other bespoke solutions
        </a>
      </div>
    </div>
  </section>

</SolutionLayout>

<script>
  interface GalleryImage {
    src: string;
    alt: string;
  }

  const dataEl = document.getElementById('gallery-data');
  const allImages: GalleryImage[] = dataEl ? JSON.parse(dataEl.textContent ?? '[]') : [];

  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.gallery-filter');
  const filterDescription = document.querySelector<HTMLElement>('.gallery-filter-description');
  const tiles = document.querySelectorAll<HTMLButtonElement>('.gallery-tile');

  const lightbox = document.querySelector<HTMLElement>('.lightbox');
  const lightboxImg = document.querySelector<HTMLImageElement>('.lightbox-img');
  const lightboxCounter = document.querySelector<HTMLElement>('.lightbox-counter');
  const lightboxClose = document.querySelector<HTMLButtonElement>('.lightbox-close');
  const lightboxPrev = document.querySelector<HTMLButtonElement>('.lightbox-prev');
  const lightboxNext = document.querySelector<HTMLButtonElement>('.lightbox-next');

  // The set of image indexes currently visible under the active filter, in order.
  let visibleIndexes: number[] = tiles.length ? Array.from(tiles, (t) => Number(t.dataset.index)) : [];
  let currentPos = 0; // position within visibleIndexes

  function openLightboxAt(index: number) {
    const pos = visibleIndexes.indexOf(index);
    if (pos === -1 || !lightbox || !lightboxImg || !lightboxCounter) return;
    currentPos = pos;
    showCurrent();
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.classList.add('overflow-hidden');
  }

  function showCurrent() {
    if (!lightboxImg || !lightboxCounter || !visibleIndexes.length) return;
    const imgIndex = visibleIndexes[currentPos];
    const data = allImages[imgIndex];
    if (!data) return;
    lightboxImg.src = data.src;
    lightboxImg.alt = data.alt;
    lightboxCounter.textContent = `${currentPos + 1} / ${visibleIndexes.length}`;
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
  }

  function showPrev() {
    if (!visibleIndexes.length) return;
    currentPos = (currentPos - 1 + visibleIndexes.length) % visibleIndexes.length;
    showCurrent();
  }

  function showNext() {
    if (!visibleIndexes.length) return;
    currentPos = (currentPos + 1) % visibleIndexes.length;
    showCurrent();
  }

  tiles.forEach((tile) => {
    tile.addEventListener('click', () => openLightboxAt(Number(tile.dataset.index)));
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxPrev?.addEventListener('click', showPrev);
  lightboxNext?.addEventListener('click', showNext);

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox?.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showPrev();
    if (e.key === 'ArrowRight') showNext();
  });

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      // No "All" button: clicking the already-active tag deselects it and
      // reveals every photo again; clicking a different tag filters to it.
      const alreadyActive = btn.classList.contains('is-active');
      filterButtons.forEach((b) => b.classList.remove('is-active'));
      const filter = alreadyActive ? 'all' : (btn.dataset.filter ?? 'all');
      if (!alreadyActive) btn.classList.add('is-active');

      if (filterDescription) {
        const text = alreadyActive ? '' : (btn.dataset.description ?? '');
        filterDescription.textContent = text;
        filterDescription.classList.toggle('opacity-0', !text);
      }

      visibleIndexes = [];
      tiles.forEach((tile) => {
        const show = filter === 'all' || tile.dataset.tag === filter;
        tile.classList.toggle('hidden', !show);
        if (show) visibleIndexes.push(Number(tile.dataset.index));
      });
    });
  });
</script>

<style>
  .gallery-filter.is-active {
    background-color: var(--color-dark);
    color: var(--color-cream);
    border-color: var(--color-dark);
  }

  @keyframes hero-kenburns {
    from { transform: scale(1); }
    to { transform: scale(1.08); }
  }

  .hero-slide-img {
    transform: scale(1);
  }

  .hero-slide-img.is-zooming {
    animation: hero-kenburns 5s ease-out forwards;
  }
</style>

<script>
  const heroTrack = document.querySelector<HTMLElement>('.hero-slider-track');
  if (heroTrack) {
    const slideEls = Array.from(heroTrack.children) as HTMLElement[];
    const realCount = slideEls.length > 1 ? slideEls.length - 1 : slideEls.length; // last child is the clone of the first, when there's more than one slide
    let current = 0;

    function zoomIn(el: HTMLElement) {
      const img = el.querySelector<HTMLElement>('.hero-slide-img');
      if (!img) return;
      img.classList.remove('is-zooming');
      void img.offsetWidth; // force reflow so the animation restarts from scratch
      img.classList.add('is-zooming');
    }

    function goNext() {
      current += 1;
      heroTrack!.style.transform = `translateX(-${current * (100 / slideEls.length)}%)`;
      zoomIn(slideEls[current]);

      if (current === realCount) {
        // We've landed on the clone (visually identical to slide 0). Kick off
        // slide 0's own zoom in lockstep with the clone's, so both are at the
        // same mid-zoom frame when we silently snap back to it below —
        // otherwise slide 0 sits frozen at its initial-load zoom and the
        // snap shows a visible jump/cut.
        zoomIn(slideEls[0]);

        // Once the swipe finishes, snap back to the real first slide with no transition.
        const handleTransitionEnd = () => {
          heroTrack!.style.transition = 'none';
          current = 0;
          heroTrack!.style.transform = 'translateX(0%)';
          void heroTrack!.offsetWidth;
          heroTrack!.style.transition = 'transform 1200ms cubic-bezier(0.65, 0, 0.35, 1)';
          heroTrack!.removeEventListener('transitionend', handleTransitionEnd);
        };
        heroTrack!.addEventListener('transitionend', handleTransitionEnd);
      }
    }

    if (realCount > 1) {
      setInterval(goNext, 5000);
    }
  }
</script>
