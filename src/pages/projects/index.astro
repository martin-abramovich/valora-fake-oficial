---
import { getCollection } from 'astro:content';
import SolutionLayout from '../../layouts/SolutionLayout.astro';
import { netlifyImage } from '../../lib/netlifyImage';
import { projectSlug } from '../../lib/projectSlug';
import projectsData from '../../content/settings/projects.json';

if (!projectsData.published) {
  return Astro.redirect('/');
}

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<SolutionLayout title="Projects — Valora" description={projectsData.page_description}>

  <!-- Title band -->
  <section class="bg-dark pt-40 pb-20 md:pt-48 md:pb-24 px-6 md:px-16">
    <div class="max-w-4xl mx-auto">
      <p class="reveal font-body text-xs tracking-widest2 text-teal uppercase mb-6">
        Valora
      </p>
      <h1 class="reveal font-heading text-cream text-5xl md:text-7xl font-light leading-[1.05] mb-6 delay-100">
        {projectsData.page_heading}
      </h1>
      <p class="reveal font-body text-cream/80 text-sm md:text-base leading-relaxed max-w-2xl delay-200">
        {projectsData.page_description}
      </p>
    </div>
  </section>

  <!-- Project grid -->
  <section class="bg-cream py-16 md:py-20 px-6 md:px-16">
    <div class="max-w-7xl mx-auto">

      <!-- 2 rows × 3 columns -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
        {projects.map((project, i) => {
          const previewImages = project.data.images.slice(0, 3);
          return (
            <article class={`reveal project-card delay-${(i % 3) * 100 + 100}`}>

              <!-- Mini slider (first 3 images) -->
              <div class="slider-wrap relative overflow-hidden aspect-square mb-4" data-total={previewImages.length}>
                <div class="slider-track flex h-full transition-transform duration-500 ease-out will-change-transform"
                     style={`width: ${previewImages.length * 100}%`}>
                  {previewImages.map((img) => (
                    <div class="h-full flex-none overflow-hidden" style={`width: ${100 / previewImages.length}%`}>
                      <img
                        src={netlifyImage(img.src, { width: 500 })}
                        alt={img.alt}
                        class="project-img w-full h-full object-cover transition-transform duration-700 ease-out"
                        loading="lazy"
                      />
                    </div>
                  ))}
                </div>

                <!-- Prev arrow -->
                <button
                  type="button"
                  class="slider-prev absolute left-2 top-1/2 -translate-y-1/2 z-10
                         w-7 h-7 flex items-center justify-center
                         bg-dark/50 hover:bg-dark/75 text-cream text-lg leading-none
                         transition-colors duration-200
                         disabled:opacity-25 disabled:pointer-events-none"
                  aria-label="Previous image"
                >
                  ‹
                </button>

                <!-- Next arrow -->
                <button
                  type="button"
                  class="slider-next absolute right-2 top-1/2 -translate-y-1/2 z-10
                         w-7 h-7 flex items-center justify-center
                         bg-dark/50 hover:bg-dark/75 text-cream text-lg leading-none
                         transition-colors duration-200
                         disabled:opacity-25 disabled:pointer-events-none"
                  aria-label="Next image"
                >
                  ›
                </button>
              </div>

              <!-- Title as button (links to the individual project page) -->
              <a
                href={`/projects/${projectSlug(project.id)}`}
                class="group relative flex items-center justify-between gap-3 border border-dark/25 px-5 py-3.5 overflow-hidden transition-colors duration-300 hover:border-teal"
              >
                <span class="font-body text-xs tracking-widest2 uppercase text-dark transition-colors duration-300 group-hover:text-teal">
                  {project.data.name}
                </span>
                <span class="flex items-center gap-2 text-teal shrink-0 opacity-0 -translate-x-3 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500 ease-out">
                  <span class="font-body text-[10px] tracking-widest2 uppercase whitespace-nowrap">Discover</span>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-none">
                    <path d="M1 8H15M15 8L9 2M15 8L9 14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Closing banner -->
  <section class="bg-white py-16 md:py-20 px-6 md:px-16">
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center gap-8">
      <div class="reveal flex flex-col sm:flex-row gap-4">
        <a href="/#contact" class="btn-filled-teal sm:whitespace-nowrap">
          Bring your vision to life
        </a>
        <a href="/#solutions" class="btn-filled-teal sm:whitespace-nowrap">
          Discover our bespoke solutions
        </a>
      </div>
    </div>
  </section>

</SolutionLayout>

<script>
  document.querySelectorAll<HTMLElement>('.slider-wrap').forEach((wrap) => {
    const track = wrap.querySelector<HTMLElement>('.slider-track')!;
    const prev  = wrap.querySelector<HTMLButtonElement>('.slider-prev')!;
    const next  = wrap.querySelector<HTMLButtonElement>('.slider-next')!;
    const total = parseInt(wrap.dataset.total ?? '1', 10);
    const step  = 100 / total; // % of track width per slide
    let current = 0;

    function goto(idx: number) {
      current = idx;
      track.style.transform = `translateX(${-idx * step}%)`;

      prev.disabled = idx === 0;
      next.disabled = idx === total - 1;
    }

    prev.addEventListener('click', () => { if (current > 0) goto(current - 1); });
    next.addEventListener('click', () => { if (current < total - 1) goto(current + 1); });

    goto(0); // set initial disabled states
  });

  // Zoom the photos only when the title button is hovered, not the photo itself
  document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
    const titleLink = card.querySelector<HTMLAnchorElement>('a');
    const images = card.querySelectorAll<HTMLImageElement>('.project-img');
    if (!titleLink) return;

    titleLink.addEventListener('mouseenter', () => {
      images.forEach((img) => img.classList.add('scale-105'));
    });
    titleLink.addEventListener('mouseleave', () => {
      images.forEach((img) => img.classList.remove('scale-105'));
    });
  });
</script>
