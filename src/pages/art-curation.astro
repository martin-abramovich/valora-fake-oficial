---
import SolutionLayout from '../layouts/SolutionLayout.astro';
import { netlifyImage } from '../lib/netlifyImage';

// Each "beat" pairs one photo with one short line; as the visitor scrolls
// through the tall wrapper below, the active beat crossfades to the next,
// while the photo itself stays pinned in place (position: sticky) for the
// whole sequence.
const beats = [
  {
    src: '/images/fine-art-curation-04.png',
    alt: 'Large scale blue and beige abstract canvas art',
    text: 'Every project begins with a single image.',
  },
  {
    src: '/images/fine-art-curation-06.png',
    alt: 'Three framed triptych coastal paintings',
    text: 'We curate for the story behind the piece, not just the palette.',
  },
  {
    src: '/images/fine-art-curation-12.png',
    alt: 'Framed geometric abstract painting',
    text: 'A more sophisticated approach than regional art alone.',
  },
  {
    src: '/images/fine-art-curation-02.png',
    alt: 'Three ornate gold-framed abstract paintings',
    text: 'The differentiator that sets every Valora space apart.',
  },
];
---

<SolutionLayout title="Art Curation — Valora" description="Elevating interior narratives through curated visual expression." navbarSolid={true} footerSolid={true}>

  <!-- Pinned photo + sequential captions, driven by scroll position -->
  <section class="beats relative" style={`height: ${beats.length * 100}vh`}>

    <!-- Pinned viewport: photos and captions stack here, crossfading between beats -->
    <div class="sticky top-0 h-screen overflow-hidden">
      {beats.map((beat, i) => (
        <img
          src={netlifyImage(beat.src, { width: 1920 })}
          alt={beat.alt}
          class={`beat-photo absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ease-in-out ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
          data-index={i}
        />
      ))}
      <div class="absolute inset-0 bg-dark/55" />

      <div class="relative z-10 h-full flex items-center justify-center px-6 md:px-16">
        {beats.map((beat, i) => (
          <p
            class={`beat-caption absolute max-w-3xl text-center font-heading text-cream text-3xl md:text-5xl font-light leading-[1.2] transition-opacity duration-1000 ease-in-out ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
            data-index={i}
          >
            {beat.text}
          </p>
        ))}
      </div>

      <!-- Progress dots -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 flex gap-3">
        {beats.map((_, i) => (
          <span class={`beat-dot w-1.5 h-1.5 rounded-full transition-colors duration-500 ${i === 0 ? 'bg-cream' : 'bg-cream/30'}`} data-index={i} />
        ))}
      </div>
    </div>

    <!-- Invisible scroll markers, one per beat, stacked through the tall section -->
    <div class="absolute inset-0">
      {beats.map((_, i) => (
        <div class="beat-trigger h-screen" data-index={i} />
      ))}
    </div>
  </section>

  <!-- Lorem ipsum body — placeholder copy for the full narrative -->
  <section class="bg-cream py-20 md:py-28 px-6 md:px-16">
    <div class="max-w-3xl mx-auto">
      <p class="reveal font-body text-xs tracking-widest2 text-teal uppercase mb-6">
        Art Curation
      </p>
      <h2 class="reveal font-heading text-dark text-3xl md:text-4xl font-light leading-[1.2] mb-8 delay-100 max-w-2xl">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit.
      </h2>
      <div class="reveal space-y-5 delay-200">
        <p class="font-body text-dark/70 text-sm md:text-base leading-relaxed">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
        </p>
        <p class="font-body text-dark/70 text-sm md:text-base leading-relaxed">
          Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
        </p>
        <p class="font-body text-dark/70 text-sm md:text-base leading-relaxed">
          Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo.
        </p>
      </div>
    </div>
  </section>

  <!-- Closing banner -->
  <section class="bg-white py-16 md:py-20 px-6 md:px-16">
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center gap-8">
      <div class="reveal flex flex-col sm:flex-row gap-4">
        <a href="/contact" class="btn-filled-teal sm:whitespace-nowrap">
          Bring your vision to life
        </a>
        <a href="/#solutions" class="btn-filled-teal sm:whitespace-nowrap">
          Discover other bespoke solutions
        </a>
      </div>
    </div>
  </section>

</SolutionLayout>

<script>
  const triggers = Array.from(document.querySelectorAll<HTMLElement>('.beat-trigger'));
  const photos = Array.from(document.querySelectorAll<HTMLElement>('.beat-photo'));
  const captions = Array.from(document.querySelectorAll<HTMLElement>('.beat-caption'));
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.beat-dot'));

  function setActive(index: number) {
    photos.forEach((el) => {
      const active = Number(el.dataset.index) === index;
      el.classList.toggle('opacity-100', active);
      el.classList.toggle('opacity-0', !active);
    });
    captions.forEach((el) => {
      const active = Number(el.dataset.index) === index;
      el.classList.toggle('opacity-100', active);
      el.classList.toggle('opacity-0', !active);
    });
    dots.forEach((el) => {
      const active = Number(el.dataset.index) === index;
      el.classList.toggle('bg-cream', active);
      el.classList.toggle('bg-cream/30', !active);
    });
  }

  // A 1px-tall detection line at the exact vertical center of the viewport.
  // Whichever full-height trigger currently spans that line is the active beat.
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          setActive(Number((entry.target as HTMLElement).dataset.index));
        }
      });
    },
    { threshold: 0, rootMargin: '-50% 0px -50% 0px' }
  );

  triggers.forEach((el) => observer.observe(el));
</script>
