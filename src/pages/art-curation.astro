---
import SolutionLayout from '../layouts/SolutionLayout.astro';
import { netlifyImage } from '../lib/netlifyImage';
import artCurationData from '../content/settings/art-curation.json';

// Each "beat" pairs one photo with one short line; as the visitor scrolls
// through the tall wrapper below, the active photo shrinks toward a framed
// card against the dark backdrop while the next one grows to fill the
// screen, continuously scrubbed by scroll position (no discrete steps).
const beats = artCurationData.beats;
---

<SolutionLayout title="Art Curation — Valora" description="Elevating interior narratives through curated visual expression." navbarSolid={true}>

  <!-- Pinned photo + sequential captions, driven by scroll position -->
  <section class="beats relative" style={`height: ${beats.length * 100}vh`}>

    <!-- Pinned viewport: dark backdrop shows through as each photo shrinks into a framed card -->
    <div class="sticky top-0 h-screen overflow-hidden bg-dark">
      {beats.map((beat, i) => (
        <img
          src={netlifyImage(beat.src, { width: 1920 })}
          alt={beat.alt}
          class="beat-photo absolute inset-0 w-full h-full object-cover shadow-[0_40px_100px_-20px_rgba(0,0,0,0.6)]"
          style={i === 0 ? undefined : 'opacity: 0'}
          data-index={i}
        />
      ))}
      <div class="absolute inset-0 bg-dark/55" />

      <div class="relative z-10 h-full flex items-center justify-center px-6 md:px-16">
        {beats.map((beat, i) => (
          <p
            class="beat-caption absolute max-w-3xl text-center font-heading text-cream text-3xl md:text-5xl font-light leading-[1.2]"
            style={i === 0 ? undefined : 'opacity: 0'}
            data-index={i}
          >
            {beat.text}
          </p>
        ))}
      </div>

      <!-- Progress dots: vertical, right-aligned, clickable to jump to a beat -->
      <div class="absolute right-4 md:right-10 top-1/2 -translate-y-1/2 z-30 flex flex-col gap-4">
        {beats.map((_, i) => (
          <button type="button" class="beat-dot-btn p-2 -m-2 cursor-pointer" data-index={i} aria-label={`Go to slide ${i + 1} of ${beats.length}`}>
            <span class={`beat-dot block w-1.5 h-1.5 rounded-full transition-colors duration-500 ${i === 0 ? 'bg-cream' : 'bg-cream/30'}`} data-index={i} />
          </button>
        ))}
      </div>

      <!-- Scroll cue: only shown on the first beat, to signal the sequence is scroll-driven -->
      <div class="scroll-cue pointer-events-none absolute bottom-10 left-1/2 -translate-x-1/2 z-30 flex flex-col items-center gap-2 transition-opacity duration-700">
        <span class="font-body text-[11px] tracking-widest2 text-cream/80 uppercase">Scroll</span>
        <svg class="w-5 h-5 text-cream/80 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Body copy, editable from the CMS -->
  <section class="bg-cream py-20 md:py-28 px-6 md:px-16">
    <div class="max-w-3xl mx-auto">
      <p class="reveal font-body text-xs tracking-widest2 text-teal uppercase mb-6">
        Art Curation
      </p>
      <h2 class="reveal font-heading text-dark text-3xl md:text-4xl font-light leading-[1.2] mb-8 delay-100 max-w-2xl">
        {artCurationData.page_heading}
      </h2>
      <div class="reveal space-y-5 delay-200">
        {artCurationData.page_paragraphs.map((para: string) => (
          <p class="font-body text-dark/70 text-sm md:text-base leading-relaxed">
            {para}
          </p>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing banner -->
  <section class="bg-white py-16 md:py-20 px-6 md:px-16">
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center gap-8">
      <div class="reveal flex flex-col sm:flex-row gap-4">
        <a href="/#contact" class="btn-filled-teal sm:whitespace-nowrap">
          Bring your vision to life
        </a>
        <a href="/#solutions" class="btn-filled-teal sm:whitespace-nowrap">
          Discover other bespoke solutions
        </a>
      </div>
    </div>
  </section>

</SolutionLayout>

<script>
  const section = document.querySelector<HTMLElement>('.beats')!;
  const photos = Array.from(document.querySelectorAll<HTMLElement>('.beat-photo'));
  const captions = Array.from(document.querySelectorAll<HTMLElement>('.beat-caption'));
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.beat-dot'));
  const dotButtons = Array.from(document.querySelectorAll<HTMLElement>('.beat-dot-btn'));
  const scrollCue = document.querySelector<HTMLElement>('.scroll-cue');

  const beatCount = photos.length;
  // Only the very first transition gets the elaborate frame treatment; every
  // later one is a plainer continuous zoom, so the motif doesn't repeat
  // identically all the way down the page.
  const FRAME_MIN_SCALE = 0.8;  // how small the outgoing/incoming photo gets at its most "framed"
  const FRAME_LIFT = 50;        // px of vertical parallax drift while framed
  const FRAME_MAX_RADIUS = 24;  // px corner rounding at full frame, echoing a picture mat
  const ZOOM_AMOUNT = 0.12;     // how much the active photo grows over its own dwell
  const ZOOM_FADE_START = 0.75; // zoom transitions crossfade only in the final quarter
  const CAPTION_LIFT = 28;      // px: outgoing text rises away, incoming text settles up into place

  const smoothstep = (t: number) => t * t * (3 - 2 * t);
  const clamp01 = (t: number) => Math.min(Math.max(t, 0), 1);

  function applyPhoto(el: HTMLElement, scale: number, y: number, opacity: number, radius: number) {
    el.style.opacity = String(opacity);
    el.style.transform = `translateY(${y}px) scale(${scale})`;
    el.style.borderRadius = `${radius}px`;
  }

  function applyCaption(el: HTMLElement, opacity: number, y: number) {
    el.style.opacity = String(opacity);
    el.style.transform = `translateY(${y}px)`;
  }

  let displayed = -1; // sentinel so the first render always syncs the dots
  let ticking = false;

  function render() {
    ticking = false;
    const vh = window.innerHeight;
    const raw = Math.min(Math.max((window.scrollY - section.offsetTop) / vh, 0), beatCount - 1);
    const index = Math.min(Math.floor(raw), beatCount - 1);
    const hasNext = index < beatCount - 1;
    const local = raw - index; // 0..1 progress through this beat's own span

    let active: number;

    if (index === 0) {
      // Beat 1 -> 2: the outgoing photo shrinks/fades out entirely across the
      // first half; only once it's gone does the incoming photo grow/fade in
      // across the second half. Keeping them time-disjoint (instead of a
      // straight crossfade) avoids the two images double-exposing over each other.
      const outT = hasNext ? smoothstep(Math.min(local, 0.5) / 0.5) : 0;
      const inT = hasNext && local > 0.5 ? smoothstep((local - 0.5) / 0.5) : 0;

      photos.forEach((el, i) => {
        if (i === index) {
          applyPhoto(el, 1 - outT * (1 - FRAME_MIN_SCALE), -outT * FRAME_LIFT, 1 - outT, outT * FRAME_MAX_RADIUS);
        } else if (hasNext && i === index + 1) {
          applyPhoto(el, FRAME_MIN_SCALE + inT * (1 - FRAME_MIN_SCALE), (1 - inT) * FRAME_LIFT, inT, (1 - inT) * FRAME_MAX_RADIUS);
        } else {
          el.style.opacity = '0';
        }
      });

      captions.forEach((el, i) => {
        if (i === index) applyCaption(el, 1 - outT, -outT * CAPTION_LIFT);
        else if (hasNext && i === index + 1) applyCaption(el, inT, (1 - inT) * CAPTION_LIFT);
        else applyCaption(el, 0, 0);
      });

      active = hasNext && local > 0.5 ? index + 1 : index;
    } else {
      // Later beats: the active photo just zooms in slowly and continuously
      // over its whole dwell, crossfading to the next one only in the last
      // quarter of the scroll span.
      const zoomScale = 1 + ZOOM_AMOUNT * local;
      const fadeT = hasNext ? smoothstep(clamp01((local - ZOOM_FADE_START) / (1 - ZOOM_FADE_START))) : 0;

      photos.forEach((el, i) => {
        if (i === index) {
          applyPhoto(el, zoomScale, 0, 1 - fadeT, 0);
        } else if (hasNext && i === index + 1) {
          applyPhoto(el, 1, 0, fadeT, 0);
        } else {
          el.style.opacity = '0';
        }
      });

      captions.forEach((el, i) => {
        if (i === index) applyCaption(el, 1 - fadeT, -fadeT * CAPTION_LIFT);
        else if (hasNext && i === index + 1) applyCaption(el, fadeT, (1 - fadeT) * CAPTION_LIFT);
        else applyCaption(el, 0, 0);
      });

      active = hasNext && fadeT > 0.5 ? index + 1 : index;
    }

    // Fades out at the very first hint of scroll, well before the frame effect
    // becomes visible, rather than lingering into the transition.
    scrollCue?.classList.toggle('opacity-0', !(index === 0 && local < 0.08));

    if (active !== displayed) {
      displayed = active;
      dots.forEach((el) => {
        const isActive = Number(el.dataset.index) === active;
        el.classList.toggle('bg-cream', isActive);
        el.classList.toggle('bg-cream/30', !isActive);
      });
    }
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(render);
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  render();

  // Clicking a dot jumps straight to that beat's scroll position.
  dotButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const index = Number(btn.dataset.index);
      window.scrollTo({ top: section.offsetTop + index * window.innerHeight, behavior: 'smooth' });
    });
  });
</script>
