---
import SolutionLayout from '../layouts/SolutionLayout.astro';
import artCurationData from '../content/settings/art-curation.json';

if (!artCurationData.published) {
  return Astro.redirect('/');
}

// Ambient looping background video (Vimeo's "background" player mode strips
// controls/title/byline and forces autoplay+loop+muted), with a short set of
// captions that cross-fade on a timer — independent of scroll, so the whole
// intro reads in one screen instead of a multi-step scroll sequence.
const videoSrc = `${artCurationData.video_url}&background=1&autoplay=1&loop=1&muted=1&byline=0&title=0&portrait=0`;
const captions = artCurationData.video_captions;
---

<SolutionLayout title="Art Curation — Valora" description="Elevating interior narratives through curated visual expression." navbarSolid={true}>

  <!-- Full-bleed video hero with cross-fading captions -->
  <section class="relative h-[90vh] md:h-screen w-full overflow-hidden bg-dark">
    <div class="video-cover absolute inset-0" aria-hidden="true">
      <iframe
        src={videoSrc}
        class="video-cover-iframe"
        tabindex="-1"
        allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
      ></iframe>
    </div>
    <div class="absolute inset-0 bg-dark/50" />

    <div class="relative z-10 h-full flex items-center justify-center px-6 md:px-16">
      {captions.map((text: string, i: number) => (
        <p
          class="hero-caption absolute max-w-3xl text-center font-heading text-cream text-3xl md:text-5xl font-light leading-[1.2] transition-opacity duration-1000"
          style={i === 0 ? undefined : 'opacity: 0'}
          data-index={i}
        >
          {text}
        </p>
      ))}
    </div>

    <!-- Scroll cue: fades out once the visitor starts scrolling -->
    <div class="scroll-cue pointer-events-none absolute bottom-10 left-1/2 -translate-x-1/2 z-30 flex flex-col items-center gap-2 transition-opacity duration-700">
      <span class="font-body text-[11px] tracking-widest2 text-cream/80 uppercase">Scroll</span>
      <svg class="w-5 h-5 text-cream/80 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </section>

  <!-- Body copy, editable from the CMS -->
  <section class="bg-cream py-20 md:py-28 px-6 md:px-16">
    <div class="max-w-3xl mx-auto">
      <p class="reveal font-body text-xs tracking-widest2 text-teal uppercase mb-6">
        Art Curation
      </p>
      <div class="reveal space-y-5 delay-100">
        {artCurationData.page_paragraphs.map((para: string) => (
          <p class="font-body text-dark/70 text-sm md:text-base leading-relaxed">
            {para}
          </p>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing banner -->
  <section class="bg-white py-16 md:py-20 px-6 md:px-16">
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center gap-8">
      <div class="reveal flex flex-col sm:flex-row gap-4">
        <a href="/#contact" class="btn-filled-teal sm:whitespace-nowrap">
          Bring your vision to life
        </a>
        <a href="/#solutions" class="btn-filled-teal sm:whitespace-nowrap">
          Discover other bespoke solutions
        </a>
      </div>
    </div>
  </section>

</SolutionLayout>

<style>
  /* Oversizes the 9:16 (portrait) iframe so it always covers its container,
     cropping the excess — the standard technique for a "background video"
     iframe, since object-fit doesn't apply across the iframe boundary.
     Ratio is locked to the source video's actual 9:16 orientation. */
  .video-cover-iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 177.78vw; /* 9:16 */
    min-width: 56.25vh; /* 9:16 */
    min-height: 100vh;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
</style>

<script>
  const captions = Array.from(document.querySelectorAll<HTMLElement>('.hero-caption'));
  const scrollCue = document.querySelector<HTMLElement>('.scroll-cue');
  const CAPTION_INTERVAL_MS = 4500;

  if (captions.length > 1) {
    let active = 0;
    setInterval(() => {
      const next = (active + 1) % captions.length;
      captions[active].style.opacity = '0';
      captions[next].style.opacity = '1';
      active = next;
    }, CAPTION_INTERVAL_MS);
  }

  function onScroll() {
    scrollCue?.classList.toggle('opacity-0', window.scrollY > 40);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
