---
import { getCollection } from 'astro:content';
import SolutionLayout from '../../layouts/SolutionLayout.astro';
import { netlifyImage } from '../../lib/netlifyImage';
import { artistSlug } from '../../lib/artistSlug';
import artistsData from '../../content/settings/artists.json';

if (!artistsData.published) {
  return Astro.redirect('/');
}

const allArtists = await getCollection('artists');
const artists = allArtists.sort((a, b) => a.data.order - b.data.order);

// Initials shown in the photo slot until a real headshot is uploaded via the CMS.
function initials(name: string): string {
  return name
    .split(' ')
    .map((part) => part[0])
    .filter(Boolean)
    .slice(0, 2)
    .join('')
    .toUpperCase();
}
---

<SolutionLayout title="Artists — Valora" description={artistsData.page_description}>

  <!-- Title band -->
  <section class="bg-dark pt-40 pb-20 md:pt-48 md:pb-24 px-6 md:px-16">
    <div class="max-w-4xl mx-auto">
      <p class="reveal font-body text-xs tracking-widest2 text-teal uppercase mb-6">
        Valora
      </p>
      <h1 class="reveal font-heading text-cream text-5xl md:text-7xl font-light leading-[1.05] mb-6 delay-100">
        {artistsData.page_heading}
      </h1>
      <p class="reveal font-body text-cream/80 text-sm md:text-base leading-relaxed max-w-2xl delay-200">
        {artistsData.page_description}
      </p>
    </div>
  </section>

  <!-- Artist grid -->
  <section class="bg-cream py-16 md:py-20 px-6 md:px-16">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-14">
        {artists.map((artist, i) => (
          <a href={`/artists/${artistSlug(artist.id)}`} class={`reveal group block delay-${(i % 3) * 100 + 100}`}>

            <!-- Photo slot: real headshot if uploaded, otherwise an initials placeholder -->
            <div class="relative overflow-hidden aspect-4/5 bg-dark/5 mb-5">
              {artist.data.photo ? (
                <img
                  src={netlifyImage(artist.data.photo, { width: 700 })}
                  alt={artist.data.name}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <span class="font-script text-teal/50 text-6xl">{initials(artist.data.name)}</span>
                </div>
              )}
              <div class="absolute bottom-0 left-0 w-1 h-16 bg-gold" />
            </div>

            <h2 class="font-heading text-dark text-xl md:text-2xl font-light leading-tight mb-1.5 group-hover:text-teal transition-colors duration-300">
              {artist.data.name}
            </h2>
            <p class="font-body text-xs tracking-widest2 text-teal uppercase mb-3">
              {artist.data.discipline}
            </p>
            <p class="font-body text-dark/70 text-sm leading-relaxed">
              {artist.data.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing banner -->
  <section class="bg-white py-16 md:py-20 px-6 md:px-16">
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center gap-8">
      <div class="reveal flex flex-col sm:flex-row gap-4">
        <a href="/#contact" class="btn-filled-teal sm:whitespace-nowrap">
          Bring your vision to life
        </a>
        <a href="/projects" class="btn-filled-teal sm:whitespace-nowrap">
          Discover our projects
        </a>
      </div>
    </div>
  </section>

</SolutionLayout>
