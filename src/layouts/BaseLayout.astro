---
import PageShell from './PageShell.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ArtCuration from '../components/ArtCuration.astro';
import Solutions from '../components/Solutions.astro';
import Projects from '../components/Projects.astro';
import Artists from '../components/Artists.astro';
import Team from '../components/Team.astro';
import Contact from '../components/Contact.astro';
import JoinTeam from '../components/JoinTeam.astro';

export interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<PageShell title={title}>
  <Hero />
  <About />
  <ArtCuration />
  <Solutions />
  <Projects />
  <Artists />
  <Team />
  <Contact />
  <JoinTeam />
</PageShell>
