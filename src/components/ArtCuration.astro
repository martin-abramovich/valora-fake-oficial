---
import artCurationData from '../content/settings/art-curation.json';
import { netlifyImage } from '../lib/netlifyImage';
---

{artCurationData.published && (
<section
  id="art-curation"
  class="bg-cream py-12 md:py-20 overflow-hidden"
>
  <div class="flex flex-col md:flex-row-reverse md:items-center gap-10 md:gap-16 lg:gap-20">

    <!-- Text column: padded right, gap to image -->
    <div class="px-6 md:pr-16 lg:pr-20 md:pl-4 md:flex-1 min-w-0">

      <p class="reveal font-body text-xs tracking-widest2 text-teal uppercase mb-6">
        {artCurationData.eyebrow}
      </p>

      <h2 class="reveal font-heading text-dark text-4xl md:text-5xl lg:text-6xl font-light leading-[1.1] mb-8 delay-100">
        {artCurationData.heading_before_em}<em class="font-script not-italic">{artCurationData.heading_em}</em>{artCurationData.heading_after_em}
      </h2>

      <div class="space-y-5 reveal delay-200">
        {artCurationData.paragraphs.map((para: string) => (
          <p class="font-body text-dark/70 text-sm md:text-base leading-relaxed">
            {para}
          </p>
        ))}
      </div>

      <div class="reveal delay-300 mt-8">
        <a href="/art-curation" class="btn-outline-dark">
          Learn more
        </a>
      </div>
    </div>

    <!-- Image column: flush to left edge on desktop -->
    <div class="reveal slide-left delay-200 px-6 md:px-0 md:shrink-0 md:w-[45%]">
      <div class="relative overflow-hidden aspect-5/4">
        <img
          src={netlifyImage(artCurationData.image, { width: 1200 })}
          alt={artCurationData.image_alt}
          class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
          loading="lazy"
        />
        <div class="absolute bottom-0 right-0 w-1 h-24 bg-gold" />
      </div>
    </div>

  </div>

  <!-- Gold separator: Art Curation → Solutions -->
  <div class="mt-12 md:mt-20 mx-6 md:mx-16 h-px bg-gold/70" />
</section>
)}
