---
import joinTeamData from '../content/settings/join-team.json';
---

<section class="bg-dark overflow-hidden">
  <div class="px-6 md:px-16 lg:px-24 py-16 md:py-20 text-center">
    <span class="ornament reveal block mb-5 text-gold text-sm" aria-hidden="true">✦</span>

    <h2 class="reveal font-heading text-cream text-3xl md:text-4xl lg:text-5xl font-light leading-[1.1] delay-100">
      {joinTeamData.heading_before_em}<em class="font-script not-italic">{joinTeamData.heading_em}</em>{joinTeamData.heading_after_em}
    </h2>

    <p class="reveal font-body text-cream/70 text-sm md:text-base mt-5 leading-relaxed delay-200">
      {joinTeamData.body}
      <a href={`mailto:${joinTeamData.email}`} class="text-gold hover:text-cream transition-colors duration-300">{joinTeamData.email}</a>
    </p>
  </div>
</section>
