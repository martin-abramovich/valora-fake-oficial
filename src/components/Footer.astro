---
import { getCollection } from 'astro:content';
import footerData from '../content/settings/footer.json';
import { netlifyImage } from '../lib/netlifyImage';
import { solutionSlug } from '../lib/solutionSlug';

export interface Props {
  // Pages that already end on a full-bleed photo (e.g. About's sticky chapters)
  // can swap the usual photo band for a solid dark one, so the logo reads
  // clearly against whatever photo comes right before it instead of stacking
  // photo-on-photo.
  solid?: boolean;
}

const { solid = false } = Astro.props;

const taglineParts = footerData.tagline.split(' · ');
const backgroundImage = netlifyImage(footerData.background_image, { width: 1600 });

const allSolutions = await getCollection('solutions');
const solutions = allSolutions.sort((a, b) => a.data.order - b.data.order);

// Mirrors the main nav so the footer sitemap always matches what's in the header.
const companyLinks = [
  { label: 'Home',    href: '/#hero' },
  { label: 'About',   href: '/#about' },
  { label: 'Team',    href: '/team' },
  { label: 'Contact', href: '/#contact' },
];
const exploreLinks = [
  { label: 'Art Curation',      href: '/#art-curation' },
  { label: 'Bespoke Solutions', href: '/#solutions' },
  { label: 'Find your rep',     href: '/team#reps' },
  { label: 'Resources',         href: '/resources' },
  { label: 'Blog',              href: '/blog' },
];

const currentYear = new Date().getFullYear();
---

<footer>

  {solid ? (
    <!-- Upper block: solid dark background + logo -->
    <div class="h-30 flex items-center justify-center bg-dark">
      <img src="/images/VALORA_logo.svg" alt="Valora" class="h-30 w-auto brightness-0 invert" />
    </div>
  ) : (
    <!-- Upper block: full-width background photo + logo -->
    <div
      class="relative h-30 flex items-center justify-center bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${backgroundImage}');`}
    >
      <!-- Dark overlay -->
      <div class="absolute inset-0 bg-dark/50" />

      <!-- Logo -->
      <div class="relative z-10">
        <img src="/images/VALORA_logo.svg" alt="Valora" class="h-30 w-auto brightness-0 invert" />
      </div>
    </div>
  )}

  <!-- Nav tree -->
  <div class="bg-teal py-14 md:py-16 px-6 md:px-16">
    <div class="max-w-7xl mx-auto grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">

      <div class="col-span-2 lg:col-span-1">
        <img src="/images/VALORA_logo.svg" alt="Valora" class="h-10 w-auto brightness-0 invert mb-4" />
        <p class="font-body text-cream/60 text-xs leading-relaxed max-w-[220px]">
          Mirrors and art handcrafted in the USA for five-star interiors.
        </p>
      </div>

      <nav aria-label="Company">
        <p class="font-body text-xs tracking-widest2 text-cream/60 uppercase mb-4">Company</p>
        <ul class="space-y-2.5">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class="font-body text-sm text-cream/80 hover:text-cream transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Explore">
        <p class="font-body text-xs tracking-widest2 text-cream/60 uppercase mb-4">Explore</p>
        <ul class="space-y-2.5">
          {exploreLinks.map((link) => (
            <li>
              <a href={link.href} class="font-body text-sm text-cream/80 hover:text-cream transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Bespoke Solutions">
        <p class="font-body text-xs tracking-widest2 text-cream/60 uppercase mb-4">Solutions</p>
        <ul class="space-y-2.5">
          {solutions.map((sol) => (
            <li>
              <a
                href={`/solutions/${solutionSlug(sol.id)}`}
                class="font-body text-sm text-cream/80 hover:text-cream transition-colors duration-200"
              >
                {sol.data.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>

    </div>
  </div>

  <!-- Tagline -->
  <div class="bg-teal border-t border-cream/15 py-4 md:h-15 flex items-center justify-center px-6 md:px-16 text-center">
    <p class="font-body text-cream/70 text-xs tracking-widest2 uppercase">
      {taglineParts.map((part: string, i: number) => (
        <>
          <span class="block sm:inline">{part}</span>
          {i < taglineParts.length - 1 && <span class="hidden sm:inline">&nbsp;&nbsp;·&nbsp;&nbsp;</span>}
        </>
      ))}
    </p>
  </div>

  <!-- Legal bar: copyright + credit -->
  <div class="bg-teal border-t border-cream/15 py-4 px-6 md:px-16 flex flex-col sm:flex-row items-center justify-center sm:justify-between gap-2 text-center">
    <p class="font-body text-cream/60 text-[11px] tracking-wide">
      © {currentYear} Valora. All rights reserved.
    </p>
    <p class="font-body text-cream/60 text-[11px] tracking-wide">
      Design by
      {' '}
      <a
        href="https://www.redacta.com.ar/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-cream/90 hover:text-cream transition-colors duration-200 underline underline-offset-2"
      >
        Redacta
      </a>
    </p>
  </div>

</footer>
