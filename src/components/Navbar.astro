---
export interface Props {
  // Pages that don't open on a dark hero (e.g. About) need the navbar to be
  // readable from scroll position 0, so it skips the transparent-until-scroll
  // behavior and stays solid from the start.
  solid?: boolean;
}

const { solid = false } = Astro.props;

// Rendered around the Team link, which gets an extra hover dropdown to the rep locator.
const navLinksBeforeTeam = [
  { label: 'Home',              href: '/#hero' },
  { label: 'About',             href: '/#about' },
  { label: 'Art Curation',      href: '/#art-curation' },
  { label: 'Bespoke solutions', href: '/#solutions' },
];
const navLinksAfterTeam = [
  { label: 'Blog',    href: '/blog' },
  { label: 'Contact', href: '/#contact' },
];
const teamLink = { label: 'Team', href: '/#team' };
const findRepLink = { label: 'Find your rep', href: '/team#reps' };
---

<header
  id="navbar"
  data-solid={solid}
  class={`fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 md:px-12 py-5 transition-all duration-500 ${solid ? 'bg-teal/90 backdrop-blur-lg shadow-md' : ''}`}
>
  <!-- Logo -->
  <a href="/#hero" class="block">
    <img src="/images/VALORA_logo.svg" alt="Valora" class="h-16 w-auto brightness-0 invert" />
  </a>

  <!-- Desktop nav -->
  <nav class="hidden md:flex items-center gap-8">
    {navLinksBeforeTeam.map((link) => (
      <a
        href={link.href}
        class="font-heading text-lg text-cream/90 hover:text-cream tracking-wide transition-colors duration-200 relative group"
      >
        {link.label}
        <span class="absolute -bottom-0.5 left-0 h-px w-0 bg-gold group-hover:w-full transition-all duration-300" />
      </a>
    ))}

    <!-- Team: hover reveals a dropdown straight to the rep locator -->
    <div class="relative group/team">
      <a
        href={teamLink.href}
        class="font-heading text-lg text-cream/90 hover:text-cream tracking-wide transition-colors duration-200 relative group"
      >
        {teamLink.label}
        <span class="absolute -bottom-0.5 left-0 h-px w-0 bg-gold group-hover:w-full transition-all duration-300" />
      </a>
      <div
        class="absolute left-1/2 -translate-x-1/2 top-full pt-3 opacity-0 invisible translate-y-1
               group-hover/team:opacity-100 group-hover/team:visible group-hover/team:translate-y-0
               transition-all duration-200"
      >
        <a
          href={findRepLink.href}
          class="block whitespace-nowrap bg-teal/95 backdrop-blur-lg shadow-md px-5 py-3
                 font-heading text-base text-cream/90 hover:text-cream transition-colors duration-200"
        >
          {findRepLink.label}
        </a>
      </div>
    </div>

    {navLinksAfterTeam.map((link) => (
      <a
        href={link.href}
        class="font-heading text-lg text-cream/90 hover:text-cream tracking-wide transition-colors duration-200 relative group"
      >
        {link.label}
        <span class="absolute -bottom-0.5 left-0 h-px w-0 bg-gold group-hover:w-full transition-all duration-300" />
      </a>
    ))}
  </nav>

  <!-- Mobile hamburger -->
  <button
    id="menu-toggle"
    class="md:hidden flex flex-col gap-1.5 p-1"
    aria-label="Toggle menu"
  >
    <span class="w-6 h-px bg-cream block transition-all duration-300" />
    <span class="w-4 h-px bg-cream block transition-all duration-300" />
    <span class="w-6 h-px bg-cream block transition-all duration-300" />
  </button>
</header>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 bg-teal/90 backdrop-blur-lg flex flex-col items-center justify-center gap-8
         translate-x-full transition-transform duration-500 md:hidden overflow-y-auto py-16"
>
  {navLinksBeforeTeam.map((link) => (
    <a
      href={link.href}
      class="mobile-link font-heading text-[2.156rem] text-cream/90 hover:text-gold transition-colors duration-200"
    >
      {link.label}
    </a>
  ))}

  <a
    href={teamLink.href}
    class="mobile-link font-heading text-[2.156rem] text-cream/90 hover:text-gold transition-colors duration-200"
  >
    {teamLink.label}
  </a>
  <a
    href={findRepLink.href}
    class="mobile-link font-heading text-lg tracking-widest2 uppercase text-cream/70 hover:text-gold transition-colors duration-200 -mt-6"
  >
    {findRepLink.label}
  </a>

  {navLinksAfterTeam.map((link) => (
    <a
      href={link.href}
      class="mobile-link font-heading text-[2.156rem] text-cream/90 hover:text-gold transition-colors duration-200"
    >
      {link.label}
    </a>
  ))}
</div>

<script>
  const navbar    = document.getElementById('navbar')!;
  const toggle    = document.getElementById('menu-toggle')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const isSolid   = navbar.dataset.solid === 'true';

  // Scroll bg
  function updateNavbar() {
    if (isSolid) return;
    if (window.scrollY > 60) {
      navbar.classList.add('bg-teal/90', 'backdrop-blur-lg', 'shadow-md');
    } else {
      navbar.classList.remove('bg-teal/90', 'backdrop-blur-lg', 'shadow-md');
    }
  }
  window.addEventListener('scroll', updateNavbar, { passive: true });
  updateNavbar();

  // Mobile toggle
  toggle.addEventListener('click', () => {
    const open = !mobileMenu.classList.contains('translate-x-full');
    mobileMenu.classList.toggle('translate-x-full', open);
    mobileMenu.classList.toggle('translate-x-0', !open);
  });

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('translate-x-full');
      mobileMenu.classList.remove('translate-x-0');
    });
  });
</script>
