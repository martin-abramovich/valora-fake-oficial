---
const navLinks = [
  { label: 'Home',              href: '#hero' },
  { label: 'About',             href: '#about' },
  { label: 'Bespoke solutions', href: '#solutions' },
  { label: 'Team',              href: '#team' },
  { label: 'Contact',           href: '#contact' },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 md:px-12 py-5 transition-all duration-500"
>
  <!-- Logo -->
  <a href="#hero" class="block">
    <img src="/images/VALORA_logo.svg" alt="Valora" class="h-16 w-auto brightness-0 invert" />
  </a>

  <!-- Desktop nav -->
  <nav class="hidden md:flex items-center gap-8">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="font-heading text-lg text-cream/90 hover:text-cream tracking-wide transition-colors duration-200 relative group"
      >
        {link.label}
        <span class="absolute -bottom-0.5 left-0 h-px w-0 bg-gold group-hover:w-full transition-all duration-300" />
      </a>
    ))}
  </nav>

  <!-- Mobile hamburger -->
  <button
    id="menu-toggle"
    class="md:hidden flex flex-col gap-1.5 p-1"
    aria-label="Toggle menu"
  >
    <span class="w-6 h-px bg-cream block transition-all duration-300" />
    <span class="w-4 h-px bg-cream block transition-all duration-300" />
    <span class="w-6 h-px bg-cream block transition-all duration-300" />
  </button>
</header>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 bg-teal/90 backdrop-blur-lg flex flex-col items-center justify-center gap-8
         translate-x-full transition-transform duration-500 md:hidden"
>
  {navLinks.map((link) => (
    <a
      href={link.href}
      class="mobile-link font-heading text-[2.156rem] text-cream/90 hover:text-gold transition-colors duration-200"
    >
      {link.label}
    </a>
  ))}
</div>

<script>
  const navbar    = document.getElementById('navbar')!;
  const toggle    = document.getElementById('menu-toggle')!;
  const mobileMenu = document.getElementById('mobile-menu')!;

  // Scroll bg
  function updateNavbar() {
    if (window.scrollY > 60) {
      navbar.classList.add('bg-teal/90', 'backdrop-blur-lg', 'shadow-md');
    } else {
      navbar.classList.remove('bg-teal/90', 'backdrop-blur-lg', 'shadow-md');
    }
  }
  window.addEventListener('scroll', updateNavbar, { passive: true });
  updateNavbar();

  // Mobile toggle
  toggle.addEventListener('click', () => {
    const open = !mobileMenu.classList.contains('translate-x-full');
    mobileMenu.classList.toggle('translate-x-full', open);
    mobileMenu.classList.toggle('translate-x-0', !open);
  });

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('translate-x-full');
      mobileMenu.classList.remove('translate-x-0');
    });
  });
</script>
