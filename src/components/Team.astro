---
import teamData from '../content/settings/team.json';
import { netlifyImage } from '../lib/netlifyImage';
---

<section
  id="team"
  class="bg-cream overflow-hidden border-t border-b border-gold/60"
>
  <div class="flex flex-col md:flex-row">

    <!-- Image column: flush left, full section height on desktop -->
    <div class="reveal slide-left order-1 md:order-none px-6 md:px-0 md:shrink-0 md:w-[45%]">
      <!-- Mobile: fixed 4/3 ratio — Desktop: fills full section height (no fixed ratio) -->
      <div class="relative overflow-hidden aspect-4/3 md:aspect-auto md:h-full">
        <img
          src={netlifyImage(teamData.image, { width: 1200 })}
          alt={teamData.image_alt}
          class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
          loading="lazy"
        />
        <div class="absolute top-0 right-0 w-1 h-full bg-teal/30 pointer-events-none" />
      </div>
    </div>

    <!-- Text column: vertically centered, padded on desktop -->
    <div class="reveal slide-right delay-200 order-2 md:order-none
                px-6 pt-10 pb-10 md:pt-0 md:pb-0
                md:pl-14 lg:pl-20 md:pr-16 lg:pr-20
                md:flex-1 md:flex md:flex-col md:justify-center min-w-0">

      <span class="ornament block mb-6 text-gold text-sm" aria-hidden="true">✦</span>

      <h2 class="font-heading text-dark text-4xl md:text-5xl lg:text-6xl font-light leading-[1.1] mb-7">
        {teamData.heading}
      </h2>

      <p class="font-body text-dark/70 text-sm md:text-base leading-relaxed max-w-md">
        {teamData.description}
      </p>
    </div>

  </div>
</section>
