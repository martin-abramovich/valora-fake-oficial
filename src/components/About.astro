---
---

<section
  id="about"
  class="bg-cream py-12 md:py-20 overflow-hidden"
>
  <div class="flex flex-col md:flex-row md:items-center gap-10 md:gap-16 lg:gap-20">

    <!-- Text column: padded left, gap to image -->
    <div class="px-6 md:pl-16 lg:pl-20 md:pr-4 md:flex-1 min-w-0">

      <p class="reveal font-body text-xs tracking-widest2 text-teal uppercase mb-6">
        About Valora — Philosophy &amp; Heritage
      </p>

      <h2 class="reveal font-heading text-dark text-4xl md:text-5xl lg:text-6xl font-light leading-[1.1] mb-8 delay-100">
        Every space has a story.
        We provide the
        <em class="font-script not-italic">art</em> to&nbsp;tell it.
      </h2>

      <div class="space-y-5 reveal delay-200">
        <p class="font-body text-dark/70 text-sm md:text-base leading-relaxed">
          Valora is a creative partner for environments that demand a distinct
          visual identity.
        </p>
        <p class="font-body text-dark/70 text-sm md:text-base leading-relaxed">
          Our process involves identifying the specific visual language a site
          requires — and executing it with the same precision with which it was
          conceived.
        </p>
        <p class="font-body text-dark/70 text-sm md:text-base leading-relaxed">
          This new chapter is backed by forty years of domestic excellence.
        </p>
      </div>
    </div>

    <!-- Image column: flush to right edge on desktop -->
    <div class="reveal slide-right delay-200 px-6 md:px-0 md:shrink-0 md:w-[45%]">
      <div class="relative overflow-hidden aspect-5/4">
        <img
          src="/images/about-interior.webp"
          alt="Luxurious interior with circular mirror and curved sofa"
          class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
          loading="lazy"
        />
        <div class="absolute bottom-0 left-0 w-1 h-24 bg-gold" />
      </div>
    </div>

  </div>

  <!-- Gold separator: About → Solutions -->
  <div class="mt-12 md:mt-20 mx-6 md:mx-16 h-px bg-gold/70" />
</section>
