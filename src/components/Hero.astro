---
---

<section
  id="hero"
  class="relative min-h-screen flex items-end overflow-hidden bg-dark"
>
  <!-- Background image placeholder — replace src with real image. -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
    style="background-image: url('/images/hero-bg-3.png');"
    aria-hidden="true"
  >
    <!-- Dark gradient overlay -->
    <div class="absolute inset-0 bg-linear-to-r from-dark/95 via-dark/50 to-dark/20" />
  </div>

  <!-- Content -->
  <div class="relative z-10 w-full px-6 md:px-16 pb-20 md:pb-28 max-w-3xl">
    <!-- Headline -->
    <h1
      class="reveal font-heading text-cream text-5xl md:text-7xl lg:text-8xl font-light leading-[1.05] mb-6"
      style="transition-delay:200ms"
    >
      Mastery <em class="font-script not-italic font-normal">in</em> every detail.
    </h1>

    <!-- Body copy -->
    <p
      class="reveal font-body text-cream/80 text-sm md:text-base leading-relaxed max-w-lg delay-300"
    >
      We transform five-star interiors into memorable experiences with mirrors
      and art proudly handcrafted in the USA.<br />
      Built on forty years of heritage.<br />
      Your vision, elevated.
    </p>

    <!-- Gold rule -->
    <div class="reveal mt-8 w-12 h-px bg-gold delay-400" />
  </div>
</section>
