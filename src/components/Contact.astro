---
import contactData from '../content/settings/contact.json';
import ContactForm from './ContactForm.astro';

const bodyLines = contactData.body.split('\n');
---

{contactData.published && (
<section
  id="contact"
  class="bg-cream overflow-hidden"
>
  <div class="flex flex-col md:flex-row md:items-stretch">

    <!-- Image column: flush left on desktop, hidden on mobile -->
    <!-- Uncomment to restore contact-arch photo
    <div class="hidden md:block md:w-64 lg:w-72 md:shrink-0 md:mr-14 lg:mr-20">
      <img
        src="/images/contact-arch.webp"
        alt="Arched teal doorway interior"
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
    -->

    <!-- Text + Form area -->
    <div class="flex-1 px-6 md:px-16 lg:px-24 pt-12 pb-16 md:pt-20 md:pb-16 grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-start">

      <!-- Text block -->
      <div>
        <span class="ornament reveal block mb-5 text-gold text-sm delay-100" aria-hidden="true">✦</span>

        <h2 class="reveal font-heading text-dark text-3x1 md:text-4xl lg:text-5xl font-light leading-[1.1] delay-200">
          {contactData.heading_before_em}
          <em class="font-script not-italic"> {contactData.heading_em}</em>
        </h2>

        <p class="reveal font-body text-dark/65 text-sm md:text-base mt-5 leading-relaxed delay-300">
          {bodyLines.map((line: string, i: number) => (
            <>
              {line}
              {i < bodyLines.length - 1 && <br />}
            </>
          ))}
        </p>

        <div class="reveal delay-400 mt-8">
          <a href="/team#reps" class="btn-outline-dark">
            Find your rep
          </a>
        </div>
      </div>

      <!-- Form -->
      <div class="reveal slide-right delay-200">
        <ContactForm />
      </div>

    </div>
  </div>
</section>
)}
